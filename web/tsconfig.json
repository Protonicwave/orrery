{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // WebGPU has no declaration in the DOM library yet, so the one the working
    // group publishes is added here. Types only: nothing is downloaded by a
    // browser and nothing is bundled.
    "types": ["vite/client", "@webgpu/types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The client alone. Everything that runs in Node, which is the build
  // configuration, the tools and both suites of tests, is checked by
  // tsconfig.node.json against the Node types, so that nothing shipped to a
  // browser can reach for a file system by accident.
  "include": ["src"]
}
