# Lint policy. Every diagnostic here is an error in CI, so each disabled check
# carries the reason it is disabled. A check is switched off because it is wrong
# for this project, never because a diagnostic was inconvenient.
---
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,

  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -modernize-use-designated-initializers,
  -cppcoreguidelines-avoid-do-while,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-uppercase-literal-suffix,
  -cert-err58-cpp,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -bugprone-random-generator-seed,
  -cert-msc32-c,
  -cert-msc51-cpp,
  -portability-avoid-pragma-once

# Rationale for the exclusions above, in order.
#
# bugprone-easily-swappable-parameters: a force kernel legitimately takes
#   several same-typed spans of positions, masses and accelerations. The check
#   fires on almost every kernel signature and the suggested remedy, wrapping
#   each argument in its own type, costs more clarity than it buys.
#
# *-magic-numbers: numerical code contains coefficients that are the definition
#   of the method rather than a name waiting to be invented. Yoshida's weights
#   and Plummer's exponents are examples. The convention in section 4 of the
#   implementation plan already requires every non-obvious constant to carry its
#   justification in a comment, which is the control that matters here.
#
# cppcoreguidelines-pro-bounds-pointer-arithmetic and -constant-array-index:
#   inner kernels take raw pointers deliberately, as the plan allows, so that
#   the compiler sees no aliasing or bounds machinery. Interfaces still use
#   std::span, which is where the bounds safety belongs.
#
# cppcoreguidelines-pro-bounds-avoid-unchecked-container-access: subscripting a
#   component array by particle index is the central idiom of this project, and
#   the remedy the check asks for is a bounds check on every one of the N^2
#   accesses a force evaluation makes. The bound is a loop invariant that the
#   caller already knows, so the check would be paid for billions of times to
#   re-establish something proved once. Bounds safety enters at the interfaces
#   instead, where std::span carries the length alongside the pointer.
#
# modernize-use-designated-initializers: the check would rewrite Vec3{1, 2, 3}
#   as Vec3{.x = 1, .y = 2, .z = 3}. For a type whose three components have a
#   universally understood order, that triples the width of every coordinate in
#   the project and makes an analytic configuration harder to read rather than
#   easier. The check earns its place on types whose fields have no conventional
#   ordering, and this project has none of those yet.
#
# cppcoreguidelines-avoid-do-while: do-while is the natural shape of a
#   convergence loop that must run at least once.
#
# misc-non-private-member-variables-in-classes: plain aggregates such as the
#   3-vector and the diagnostics record are data, and wrapping their members in
#   accessors would obstruct constexpr use and vectorisation for no benefit.
#
# modernize-use-trailing-return-type: a stylistic preference with no effect on
#   correctness. Formatting and style are settled by .clang-format.
#
# readability-identifier-length: i, j, dx and r2 are the conventional names in
#   this domain and are clearer than the long forms the check would demand.
#
# readability-uppercase-literal-suffix: the float suffix reads better lower
#   case next to physical quantities, and the precision switch means suffixes
#   appear mostly inside type aliases anyway.
#
# cert-err58-cpp: Catch2 registers its test cases through static objects whose
#   constructors may throw, which is the framework's design rather than ours.
#
# clang-analyzer-optin.core.EnumCastOutOfRange: the check objects to casting a
#   combination of flag values back to the enumeration they came from, which is
#   how every flag enumeration in C++ has always worked. It fires inside Catch2,
#   on the assertion macros rather than on anything this repository wrote, and
#   the analyser reaches it only along some paths, so it appears and disappears
#   with unrelated edits to a test. There is nothing to act on and no way to
#   suppress it at the call site without a macro.
#
# bugprone-random-generator-seed and its cert aliases: these object to seeding a
#   generator with a constant, which is exactly what this project requires. A
#   property test that cannot be re-run on the input that failed it is not
#   evidence of anything, and a sampled set of initial conditions that differs
#   between runs makes every result that follows from it unreproducible. The
#   convention in section 4 of the implementation plan states the rule the check
#   would otherwise enforce the opposite of: randomness is seeded explicitly and
#   the seed is recorded in the failure message. Nothing here is cryptographic,
#   which is the setting the check was written for.
#
# portability-avoid-pragma-once: the remedy this check asks for is an include
#   guard, which is a macro, and section 4 of the implementation plan avoids
#   macros entirely. The portability the check protects is theoretical here:
#   the three compilers this project supports have all implemented pragma once
#   for many years, and the project builds on nothing else.

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/orrery|src|tests|benchmarks)/.*'
FormatStyle: file

CheckOptions:
  # Naming follows section 4 of the implementation plan: types PascalCase,
  # functions and variables snake_case, private members trailing underscore,
  # constants kPascalCase.
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _
  # Only compile-time and namespace-scope constants take the k prefix. A local
  # const is an ordinary variable and keeps snake_case.
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # The exception to the naming rules above. A type that plugs into the standard
  # library has to spell its member aliases the way the standard library asks
  # for them: an allocator whose value_type were named ValueType would simply
  # not be an allocator. These names are dictated from outside the project, so
  # they are exempt rather than renamed, and the exemption lists them
  # individually so that it cannot quietly cover anything else.
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^(value_type|size_type|difference_type|pointer|const_pointer|reference|const_reference|iterator|const_iterator|propagate_on_container_[a-z_]+|is_always_equal|other)$'

  # A function long enough to trip these limits is doing more than one thing.
  # The kernels are the expected exception and are reviewed on their own terms.
  - key: readability-function-size.LineThreshold
    value: 120
  - key: readability-function-cognitive-complexity.Threshold
    value: 30
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true

  # Passing a 3-vector of three doubles by value is cheaper than by reference,
  # so the threshold is set above its size rather than at the default.
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'Vec3'
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'catch2/.*'
...
