# Build trees. CMake presets place every configuration under build/.
build/
out/
install/
cmake-build-*/

# CMake artefacts that can appear outside a build tree.
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/

# Compiler and linker output.
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# Sanitiser, profiler and coverage output.
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
perf.data
perf.data.old
callgrind.out.*
asan.log.*
ubsan.log.*

# Simulation output. Trajectories and checkpoints are large and reproducible
# from a configuration file, so they are never committed. The extensions are
# the ones the formats actually use: .orrery is the configuration, which is the
# input and belongs in the history.
*.otj
*.ock
results/
frames/
*.mp4

# One exception, and the reason it is worth making: the trajectory reader in
# web/ is checked against files the C++ wrote, and a test whose input has to be
# regenerated by a toolchain nobody installed to work on the client is a test
# that stops being run. These are a few hundred bytes each.
!web/tests/fixtures/*.otj

# The published gallery. Produced by web/tools/publish_gallery.ts from the
# configurations in examples/, in the site workflow and by hand, for the same
# reason no other trajectory is committed: it is output.
web/public/gallery/

# Python tooling for the bindings and the example notebooks.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Editors and operating systems.
.vscode/
.vs/
.idea/
.cache/
*.swp
.DS_Store
Thumbs.db

# Browser client. Dependencies, build output and test artefacts: each is
# produced by one command, and none of them belongs in the history.
node_modules/
dist/
playwright-report/
test-results/
